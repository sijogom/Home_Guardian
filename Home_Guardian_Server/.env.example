# Home Guardian 환경변수 예시
# 운영자가 자신의 값으로 채워 같은 폴더의 `.env.local` 에 저장한다.
# 실제 값은 .env.local에만 저장한다. 이 .env.example은 공개하는 빈 설정 템플릿이다.
#
# Windows의 `.env.local`은 배포 접속 정보에만 사용한다. 이 예시 파일 전체를
# 라즈베리파이의 `/etc/home-guardian/auth.env`로 복사하면 안 된다.

# ─ 백엔드 런타임 ─
# SQLite 파일 위치. 미지정 시 Home_Guardian/.tmp/home_guardian.sqlite3 (개발용, 시작 시 runtime 상태 초기화)
HOME_GUARDIAN_DB_PATH=/srv/home-guardian/runtime/home_guardian.sqlite3

# 운영 시 mobile 앱이 호출할 base URL (참고)
HOME_GUARDIAN_PUBLIC_BASE_URL=https://your-backend.example.com

# ─ 배포 스크립트 (Home_Guardian_Server/deploy/scripts/deploy.ps1) ─
# SSH 접속 사용자와 호스트. 실행 환경에서 자신의 값으로 채운다.
HG_RPI_USER=
HG_RPI_HOST=

# 라즈베리파이 디렉토리 (기본값을 그대로 쓰면 비워둬도 됨)
HG_RPI_APP_ROOT=/srv/home-guardian
HG_RPI_SERVER_ROOT=/srv/home-guardian-server

# ─ 라즈베리파이 /etc/home-guardian/auth.env 계약 ─
# 정식 운영 파일에는 아래 필수 키 6개와 선택 키 1개 외 다른 키를 넣지 않는다.
# 각 값은 따옴표·공백·주석 없이 정확히 KEY=value 한 줄로 기록한다.
# access token 서명 시크릿. 운영(라즈베리파이)은 비밀 관리 절차로
# /etc/home-guardian/auth.env 에만 무작위 강력 값을 주입한다.
# root:root / 0600 이 아니거나 32자 미만이면 설치 스크립트가 서비스 시작 전에 중단한다.
# 미설정 시 준비 상태가 실패한다. 절대 소스·문서·저장소에 실제 값을 넣지 않는다.
HG_AUTH_TOKEN_SECRET=
# 실제 Android OAuth 클라이언트 ID. 개발용 fallback 없이 서버가 Google ID token을
# 검증할 때 사용한다. /etc/home-guardian/auth.env 에 실제 값을 주입한다.
GOOGLE_CLIENT_ID=
# Firebase Admin service-account JSON의 고정 경로. 실제 JSON은 payload에 넣지 않고
# `/etc/home-guardian/credentials/`에 별도로 설치한다(root:<service-group>, 0640).
FIREBASE_CREDENTIALS=/etc/home-guardian/credentials/firebase-service-account.json
# 미식별 제품 검토용 localhost 내부 API 시크릿. 32자 이상의 별도 무작위 값을
# 같은 /etc/home-guardian/auth.env 에만 저장한다. 사용하지 않으면 이 키의 줄 자체를
# 생략한다. 설정하지 않으면 내부 검토 API만
# 503으로 비활성화되고 주민용 점검 API는 계속 동작한다. 실제 값은 기록하지 않는다.
HG_IDENTITY_REVIEW_SECRET=
# 비AI 공식 제품 조회는 항상 동작한다. 아래 flag는 조회 실패 뒤 사용할 선택적
# OpenAI 보강만 제어한다. 0이어도 기존 key/model 줄은 보존할 수 있지만 호출하지
# 않는다. 새 이름이 있으면 legacy HG_IDENTITY_RESEARCH_ENABLED보다 우선한다.
HG_IDENTITY_AI_RESEARCH_ENABLED=0
# AI 보강을 명시적으로 사용할 때만 flag를 1로 바꾸고 유효한 두 값을 요구한다.
# 실제 키는 이 예시나 payload·문서·로그에 기록하지 않는다.
# OPENAI_API_KEY=sk-...
# HG_IDENTITY_RESEARCH_MODEL=gpt-5-mini
